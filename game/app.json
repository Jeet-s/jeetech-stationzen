{
  "expo": {
    "name": "Station Zen",
    "slug": "station-zen-calm-metro-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.jeetech.stationzen",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "backgroundColor": "#71553d"
      }
    },
    "ios": {
      "bundleIdentifier": "com.jeetech.stationzen",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "scheme": "station-zen-calm-metro-builder",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ]
    ],
    "icon": "./assets/store/icon.png"
  }
}
